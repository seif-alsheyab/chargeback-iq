# Copy to .env and adjust. .env is gitignored and must never be committed.
NODE_ENV=development
PORT=4010

# Postgres runs in Docker on 5433, not 5432, to avoid colliding with any
# other Postgres on this machine (including the employer Compose stack).
DATABASE_URL=postgres://chargeback:chargeback_dev_pw@localhost:5433/chargeback_iq

# Shared secret PSP webhook senders sign their requests with (HMAC-SHA256).
WEBHOOK_SIGNING_SECRET=replace_me_in_production

LOG_LEVEL=info
