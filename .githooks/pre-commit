#!/usr/bin/env bash
# Guard: this repo must only ever carry commits authored by Sief Alsheyab.
# The machine's global git identity is a different account, so without this
# hook a missing local config would silently produce unattributed commits.
EXPECTED="alsheyab.seif@gmail.com"
ACTUAL="$(git config user.email || true)"
if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "" >&2
  echo "COMMIT BLOCKED — wrong author identity" >&2
  echo "  configured : ${ACTUAL:-<unset>}" >&2
  echo "  expected   : $EXPECTED" >&2
  echo "  fix        : git config user.email \"$EXPECTED\"" >&2
  echo "               git config user.name  \"Sief Alsheyab\"" >&2
  echo "" >&2
  exit 1
fi
