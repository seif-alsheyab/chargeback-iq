{
  "name": "chargeback-iq",
  "version": "0.1.0",
  "private": true,
  "description": "Dispute and chargeback operations platform: lifecycle tracking, evidence management, deadline control, and processor performance analytics.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node src/db/migrate.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U chargeback -d chargeback_iq",
    "seed": "node scripts/seed.js",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 6 && npm run migrate"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seif-alsheyab/chargeback-iq.git"
  },
  "keywords": [
    "chargebacks",
    "disputes",
    "payments",
    "risk",
    "fraud",
    "visa",
    "mastercard",
    "vamp",
    "postgresql"
  ],
  "author": "Sief Alsheyab"
}
